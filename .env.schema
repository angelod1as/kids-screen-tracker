# Kids Screen Tracker — schema das variáveis de ambiente (Varlock).
#
# Este arquivo É versionado. Ele declara quais variáveis existem, seus tipos e
# quais são sensíveis — nunca os valores.
#
# Os valores ficam em .env, que é ignorado pelo git. Preencha-os lá.

# @defaultRequired=true
# @defaultSensitive=true
# @generateTsTypes(path=env.d.ts)
# ---

# Caminho do arquivo SQLite. Em produção deve apontar para dentro do volume
# persistente declarado no Dockerfile, ou o banco morre no redeploy.
#
# Marcado como sensível, e não por ser segredo: sensível é o que impede o
# varlock de embutir o valor no bundle durante o build. Como não sensível, o
# caminho do build ia inlinado para o servidor — medido, seis arquivos dentro de
# .next/ com o literal — e a app abria o banco do BUILD, não o do runtime.
# Trocar o valor no painel do Coolify seria ignorado em silêncio. É valor só de
# servidor e nunca deve chegar ao cliente, então a marcação também é
# semanticamente a certa.
# @type=string @required @sensitive @example="./data/kids.db"
DATABASE_PATH=

# Segredo usado para assinar o cookie de sessão (HMAC).
# Trocar este valor invalida a sessão de todo mundo na hora.
# Gere com: openssl rand -base64 48
#
# Precisa de no mínimo 32 caracteres, e isso é verificado em código
# (`assertUsableSecret`, em src/auth/token.ts), não aqui: o @required do
# varlock garante que a variável existe, não que ela presta. Com um segredo de
# 1 caractere o cookie foi forjado em 26 tentativas; com um segredo vazio os
# tokens verificavam normalmente. A app se recusa a assinar ou verificar
# qualquer coisa abaixo do mínimo, e falha na primeira requisição em vez de
# servir cookie forjável em silêncio.
# @type=string @required @sensitive
SESSION_SECRET=
